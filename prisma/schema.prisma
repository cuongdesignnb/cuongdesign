datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ProductType {
  SOURCE_CODE
  TEMPLATE
  UI_KIT
  SERVICE
}

enum ProjectSchemaKind {
  CREATIVE_WORK
  SOFTWARE_SOURCE_CODE
  WEB_SITE
  WEB_APPLICATION
}

enum ProductPricingMode {
  FIXED
  FREE
  CONTACT
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  LIMITED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum AiTaskStatus {
  PENDING
  GENERATING_TEXT
  GENERATING_IMAGE
  COMPLETED
  FAILED
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ChatSessionStatus {
  AI_ACTIVE // AI is automatically responding
  HUMAN_ACTIVE // Admin has taken over manually
  CLOSED // Conversation closed
}

enum SenderType {
  USER
  AI
  ADMIN
}

// User accounts (Admin and Customers)
model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  password                String // Hashed password
  name                    String?
  avatar                  String?
  role                    Role              @default(CUSTOMER)
  orders                  Order[] // Customer orders
  reviews                 Review[] // Customer reviews
  updatedContentDocuments ContentDocument[] @relation("ContentDocumentUpdatedBy")
  contentRevisions        ContentRevision[] @relation("ContentRevisionCreatedBy")
  mediaUploads            Media[]           @relation("MediaCreatedBy")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// Reusable media uploads library
model Media {
  id          String           @id @default(cuid())
  name        String
  url         String           @unique
  size        Int
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  mimeType    String?
  storageKey  String?
  createdById String?
  createdBy   User?            @relation("MediaCreatedBy", fields: [createdById], references: [id])
  services    ServiceContent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model ContentDocument {
  id            String            @id @default(cuid())
  key           String            @unique
  name          String
  route         String?
  schemaVersion Int               @default(1)
  draftData     Json
  publishedData Json?
  status        ContentStatus     @default(DRAFT)
  publishedAt   DateTime?
  updatedById   String?
  updatedBy     User?             @relation("ContentDocumentUpdatedBy", fields: [updatedById], references: [id])
  revisions     ContentRevision[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ContentRevision {
  id          String          @id @default(cuid())
  documentId  String
  document    ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  data        Json
  note        String?
  createdById String?
  createdBy   User?           @relation("ContentRevisionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@unique([documentId, version])
}

model ServiceContent {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  subtitle         String?
  shortDescription String    @db.Text
  heroContent      String    @db.Text
  iconKey          String?
  colorKey         String?
  coverMediaId     String?
  coverMedia       Media?    @relation(fields: [coverMediaId], references: [id])
  priceText        String?
  durationText     String?
  features         Json
  process          Json
  faqs             Json
  ctaText          String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]
  canonicalPath    String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  robotsIndex      Boolean   @default(true)
  robotsFollow     Boolean   @default(true)
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// General and page-specific configurations (Home, About, SMTP, colors, AI chatbot keys)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "smtp_host", "theme_primary_color", "homepage_seo", "ai_chat_prompt"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Dynamic Policy Pages (Privacy policy, Terms of service, etc.)
model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique // e.g. "chinh-sach-bao-mat"
  content        String   @db.Text
  isPublished    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  canonicalPath  String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean  @default(true)
  robotsFollow   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Showcase Projects
model Project {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  description    String
  content        String            @db.Text
  coverImage     String
  images         String[]
  category       String            @default("Web Application")
  demoUrl        String?
  githubUrl      String?
  techStack      String[]
  projectType    ProjectSchemaKind @default(CREATIVE_WORK)
  clientName     String?
  clientIndustry String?
  projectRole    String?
  completedAt    DateTime?
  projectResult  String?           @db.Text
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  canonicalPath  String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean           @default(true)
  robotsFollow   Boolean           @default(true)
  isPublished    Boolean           @default(false)
  publishedAt    DateTime?
  isFeatured     Boolean           @default(false)
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// Digital Products for Sale / Free download
model Product {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  description      String
  content          String?             @db.Text
  price            Float
  salePrice        Float?
  currency         String              @default("VND")
  pricingMode      ProductPricingMode  @default(FIXED)
  availability     ProductAvailability @default(IN_STOCK)
  priceValidUntil  DateTime?
  type             ProductType         @default(SOURCE_CODE)
  sku              String?             @unique
  brandName        String?
  softwareCategory String?
  operatingSystem  String?
  softwareVersion  String?
  licenseName      String?
  features         String[]
  techStack        String[]
  coverImage       String
  images           String[]
  demoUrl          String?
  downloadUrl      String?
  maxDownloads     Int                 @default(5)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]
  canonicalPath    String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  robotsIndex      Boolean             @default(true)
  robotsFollow     Boolean             @default(true)
  isPublished      Boolean             @default(false)
  publishedAt      DateTime?
  isFeatured       Boolean             @default(false)
  order            Int                 @default(0)
  orders           Order[]
  reviews          Review[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

// Product reviews from verified buyers
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      @default(5) // 1 to 5 stars
  comment    String   @db.Text
  isApproved Boolean  @default(false) // Must be approved by admin
  createdAt  DateTime @default(now())
}

// Orders processed via SePay Webhook
model Order {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  userId        String? // Nullable for guest checkouts
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String?
  amount        Float
  status        OrderStatus @default(PENDING)
  paymentMethod String      @default("SEPAY")
  sepayCode     String      @unique // Unique bank transfer content
  downloadCount Int         @default(0) // Download attempts
  downloadToken String?     @unique // Unique download token sent via email
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Blog Categories
model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?  @db.Text
  coverImage     String?
  color          String? // hex color for UI badge e.g. "#ec4899"
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  canonicalPath  String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean  @default(true)
  robotsFollow   Boolean  @default(true)
  order          Int      @default(0)
  posts          Post[]
  aiTasks        AiTask[] @relation("AiTaskCategory")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Blog Posts
model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?    @db.Text
  content        String     @db.Text
  coverImage     String?
  coverImageAlt  String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id])
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  canonicalPath  String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean    @default(true)
  robotsFollow   Boolean    @default(true)
  schemaMarkup   Json?
  aiTask         AiTask?    @relation("AiGeneratedPost")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// AI Post Generator Queue
model AiTask {
  id              String       @id @default(cuid())
  keyword         String
  status          AiTaskStatus @default(PENDING)
  scheduleTime    DateTime
  generatedPostId String?      @unique
  generatedPost   Post?        @relation("AiGeneratedPost", fields: [generatedPostId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?    @relation("AiTaskCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  autoPublish     Boolean      @default(false)
  tone            String       @default("professional")
  length          String       @default("medium")
  sharedKeywords  String[]     @default([])
  withImages      Boolean      @default(false)
  imageCount      Int          @default(0)
  attempts        Int          @default(0)
  maxAttempts     Int          @default(3)
  claimToken      String?      @unique
  lockedAt        DateTime?
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, scheduleTime])
  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([categoryId])
}

// Live Chat Sessions
model ChatSession {
  id        String            @id @default(cuid())
  socketId  String?
  status    ChatSessionStatus @default(AI_ACTIVE)
  messages  ChatMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// Chat Messages
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    SenderType
  content   String      @db.Text
  createdAt DateTime    @default(now())
}

// Leads & Free Product Request Contact Forms
model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String   @db.Text
  productId   String? // References the free product if applicable
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Testimonials Showcase
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String?
  avatar      String
  rating      Int      @default(5)
  quote       String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Hierarchical Navigation Menu
model MenuItem {
  id        String     @id @default(cuid())
  label     String
  href      String? // Nullable if it's a dropdown header category
  order     Int        @default(0)
  parentId  String?
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SeoRedirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  permanent       Boolean  @default(true)
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([destinationPath])
}
